# Konfiguracja wysyłki outreachowej (automation/scripts/send-outreach.mjs).
# Skopiuj do automation/.env na czas pracy lokalnej. W GitHub Actions te same
# nazwy trafiają do Secrets (klucze) i Variables (reszta).

# --- kolejka leadów: web app Apps Script przed arkuszem Google ---
# URL kończy się na /exec. Token musi być identyczny jak TOKEN w queue.gs.
OUTREACH_QUEUE_URL=
OUTREACH_QUEUE_TOKEN=

# --- wysyłka ---
# Klucz z https://resend.com (darmowy plan wystarcza na start).
RESEND_API_KEY=
# NIE używaj adresu na couders.com. Zimna wysyłka spali reputację domeny,
# na której stoi strona i poczta firmowa. Skrypt to blokuje.
OUTREACH_FROM="Michał z Couders <michal@couders-ai.com>"
OUTREACH_REPLY_TO=
# Skrzynka do wypisywania się. Musi być realnie czytana.
OUTREACH_UNSUBSCRIBE_MAILBOX=stop@couders-ai.com
# Pełna identyfikacja nadawcy, doklejana do każdej wiadomości.
OUTREACH_SENDER_BLOCK="Couders, Kraków | NIP 0000000000 | couders.com"

# --- bezpieczniki ---
# Bez OUTREACH_ENABLED=true skrypt odmawia wysyłki. To główny włącznik.
OUTREACH_ENABLED=false
OUTREACH_DAILY_CAP=20
OUTREACH_WINDOW_START=8
OUTREACH_WINDOW_END=17
OUTREACH_WEEKDAYS_ONLY=true
OUTREACH_TIMEZONE=Europe/Warsaw
# Odstępy w dniach między krokami sekwencji, liczone od pierwszej wiadomości.
OUTREACH_STEP_DELAYS=0,3,7
# Awaryjne odblokowanie domeny głównej. Zostaw false.
OUTREACH_ALLOW_PRIMARY_DOMAIN=false
OUTREACH_PRIMARY_DOMAIN=couders.com
