# Konfiguracja wysyłki. Skopiuj do automation/.env i uzupełnij.
# automation/.env jest w .gitignore i nigdy nie trafia do repo.
#
# ==========================================================================
# TRYB LOKALNY (domyślny): scripts/send-local.mjs
# Paczki wiadomości pisze Claude, skrypt je tylko rozsyła z Twojej skrzynki.
# Nie potrzebuje żadnego klucza API.
# ==========================================================================

# --- skrzynka nadawcza ---
# gmail albo outlook ustawia host i port automatycznie. Dla własnego hostingu
# zostaw puste i wypełnij SMTP_HOST / SMTP_PORT.
SMTP_PRESET=gmail
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

# Pełny adres skrzynki i HASŁO APLIKACJI, nie hasło do konta.
# Gmail: konto Google -> Bezpieczeństwo -> Weryfikacja dwuetapowa (musi być
# włączona) -> Hasła aplikacji. Ciąg 16 znaków, spacje można pominąć.
SMTP_USER=michal@couders-ai.com
SMTP_PASS=

# --- jak podpisujesz maile ---
# NIE używaj adresu na couders.com. Zimna wysyłka spali reputację domeny,
# na której stoi strona i firmowa poczta. Skrypt to blokuje.
OUTREACH_FROM="Michał z Couders <michal@couders-ai.com>"
OUTREACH_REPLY_TO=
# Skrzynka do wypisywania się. Musi być realnie czytana.
OUTREACH_UNSUBSCRIBE_MAILBOX=stop@couders-ai.com
# Pełna identyfikacja nadawcy, doklejana do każdej wiadomości.
OUTREACH_SENDER_BLOCK="Couders, Kraków | NIP 0000000000 | couders.com"

# --- tempo ---
# Losowy odstęp między wiadomościami, w minutach.
OUTREACH_MIN_MINUTES=10
OUTREACH_MAX_MINUTES=12
# Ile maksymalnie wiadomości dziennie, licząc wszystkie paczki.
OUTREACH_DAILY_CAP=20
# Okno wysyłki w czasie lokalnym. Nikt nie pisze zimnych maili o 4 rano.
OUTREACH_WINDOW_START=8
OUTREACH_WINDOW_END=17
OUTREACH_WEEKDAYS_ONLY=true
OUTREACH_TIMEZONE=Europe/Warsaw

# --- bezpiecznik domeny ---
OUTREACH_ALLOW_PRIMARY_DOMAIN=false
OUTREACH_PRIMARY_DOMAIN=couders.com

# ==========================================================================
# TRYB ZAUTOMATYZOWANY (opcjonalny): scripts/send-outreach.mjs
# Kolejka w arkuszu Google, wysyłka przez Resend, harmonogram w GitHub
# Actions. Wymaga kluczy API. Zostaw puste, jeśli używasz trybu lokalnego.
# ==========================================================================
OUTREACH_QUEUE_URL=
OUTREACH_QUEUE_TOKEN=
RESEND_API_KEY=
OUTREACH_ENABLED=false
OUTREACH_STEP_DELAYS=0,3,7
