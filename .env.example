# --- Phase 3: on-site AI chatbot (Claude) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model for the live agent. Current generation: claude-opus-5 | claude-sonnet-5 |
# claude-haiku-4-5. Opus is the default; drop to a smaller model only after
# measuring that answer quality holds.
ANTHROPIC_MODEL=claude-opus-5

# --- Contact page (/contact): forward form submissions to a webhook ---
# Paste a Make.com / Zapier / Google Apps Script webhook URL that appends a
# row to a Google Sheet. Receives POST JSON: { firstName, lastName, email,
# message, timestamp }. Server-only (never exposed to the client). Until
# this is set, submissions still succeed for visitors but are only logged
# server-side, not forwarded anywhere.
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Prospect demos (/pl/demo/?id=...) ---
# Base URL of the n8n instance that serves the demo config and the demo chat,
# up to and including /webhook. Public by design (the browser calls it), so it
# belongs in a repository variable, not a secret. The workflows behind it live
# in n8n/ and hold the API key and the sheet token.
# Example: https://n8n.couders.com/webhook
NEXT_PUBLIC_DEMO_API=
