            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\": \"={{ $env.ANTHROPIC_MODEL || 'claude-opus-5' }}\", \"max_tokens\": 1000, \"output_config\": {\"effort\": \"low\"}, \"system\": \"={{ $json.system }}\", \"messages\": \"={{ $json.messages }}\"}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "6aa08524-afd6-48fa-a2ca-d4c19a6e6228",
      "name": "Zapytaj Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Claude returns content blocks; the page only needs the text. A refusal or an\n// empty turn must still produce something the visitor can read.\nconst text = ($json.content ?? [])\n  .filter((b) => b.type === 'text')\n  .map((b) => b.text)\n  .join('\\n')\n  .trim();\n\nif ($json.stop_reason === 'refusal' || !text) {\n  return [{ json: { reply: 'Na to nie odpowiem. Napiszcie do zespołu, odezwiemy się.', status: 200 } }];\n}\nreturn [{ json: { reply: text, status: 200 } }];\n"
      },
