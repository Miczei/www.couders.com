      "id": "948d52b1-6458-4b2d-9c04-31eea051e815",
      "name": "Wczytaj demo (chat)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -380,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Builds the Claude request for one visitor message. Two rules matter here:\n// the assistant may only use the facts gathered from the company's own site,\n// and the transcript is capped so a long session cannot grow the bill without\n// bound.\nconst body = $('Demo: rozmowa').first().json.body ?? {};\nconst id = String(body.id ?? '').trim();\nconst demo = ($json.demos ?? []).find((d) => d.token === id);\n\nif (!demo) return [{ json: { error: 'Nie znamy tego demo.', status: 404 } }];\n\nlet cfg;\ntry { cfg = JSON.parse(demo.config); } catch { return [{ json: { error: 'Uszkodzona konfiguracja.', status: 500 } }]; }\n\nif (cfg.expiresAt && new Date(cfg.expiresAt) < new Date()) {\n  return [{ json: { error: 'To demo wygasło.', status: 410 } }];\n}\n\nconst history = Array.isArray(body.messages) ? body.messages : [];\nconst messages = history\n  .filter((m) => m && (m.role === 'user' || m.role === 'assistant') && typeof m.content === 'string')\n  .slice(-12)\n  .map((m) => ({ role: m.role, content: m.content.slice(0, 2000) }));\n\nif (!messages.length || messages[messages.length - 1].role !== 'user') {\n  return [{ json: { error: 'Brak pytania.', status: 400 } }];\n}\n\nconst knowledge = (cfg.facts ?? [])\n  .map((f, i) => `${i + 1}. Pytanie: ${f.q}\\n   Odpowiedź: ${f.a}`)\n  .join('\\n');\n\nconst system = [\n  cfg.systemPrompt,\n  '',\n  'Wiedza o firmie, wyłącznie na jej podstawie odpowiadasz:',\n  knowledge,\n  '',\n  'Zasady: odpowiadaj krótko, maksymalnie 4 zdania. Nie wymyślaj cen, terminów ani',\n  'parametrów, których nie ma powyżej. Jeśli pytanie wykracza poza tę wiedzę, powiedz',\n  'to wprost i zaproponuj kontakt z zespołem. Odpowiadasz po polsku.',\n].join('\\n');\n\nreturn [{ json: { system, messages } }];\n"
      },
      "id": "96bbc9f1-ef03-4f38-85a9-ac75e94df325",
      "name": "Zbuduj zapytanie",
