      "id": "22fa35f0-fab2-4e5c-be2c-f8e2385e1135",
      "name": "Wczytaj demo (config)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -380,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Serves one demo to the page. The token is the only credential a prospect\n// has, so an unknown or expired one gets a clean \"gone\" rather than a stack\n// trace, and the sheet token never leaves this workflow.\nconst id = String($('Demo: konfiguracja').first().json.query?.id ?? '').trim();\nconst demo = ($json.demos ?? []).find((d) => d.token === id);\n\nif (!demo) {\n  return [{ json: { ok: false, status: 404, error: 'Nie znamy tego demo.' } }];\n}\n\nlet cfg;\ntry {\n  cfg = JSON.parse(demo.config);\n} catch {\n  return [{ json: { ok: false, status: 500, error: 'Konfiguracja demo jest uszkodzona.' } }];\n}\n\nif (cfg.expiresAt && new Date(cfg.expiresAt) < new Date()) {\n  return [{ json: { ok: false, status: 410, error: 'To demo wygasło.', company: cfg.company } }];\n}\n\n// facts and systemPrompt drive the answers; they stay server side so the page\n// cannot be scraped for the whole knowledge base at once.\nreturn [{ json: { ok: true, status: 200, company: cfg.company, tagline: cfg.tagline ?? '',\n                  intro: cfg.intro, suggested: cfg.suggested ?? [], expiresAt: cfg.expiresAt ?? '' } }];\n"
      },
      "id": "2222c239-558e-4f03-a38e-640ab4387022",
      "name": "Złóż konfigurację",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -140,
        160
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
