# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# local MCP config (may contain API keys — never commit)
.mcp.json

# typescript
*.tsbuildinfo
next-env.d.ts

# generated media (large Higgsfield assets — keep out of git, host on CDN)
/public/*.mp4

# macOS file-sync duplicates ("Foo 2.tsx"). They are never intentional and
# have been committed by accident before.
*[[:space:]]2.tsx
*[[:space:]]2.html
*[[:space:]]2.ts

# Listy leadów: dane osobowe (imiona, stanowiska, LinkedIn, adresy e-mail).
# To repo jest publiczne, więc takie pliki NIGDY nie trafiają do gita.
docs/outreach/*.csv

# Lokalna konfiguracja wysyłki (klucze API, token arkusza).
automation/.env

# Wysyłka lokalna (automation/): zależności, stan wysyłki, paczki z danymi
# osobowymi i lista wypisanych. Repo jest publiczne, więc nic z tego nie
# trafia do gita. Wzorcowa paczka outbox/przyklad.json jest wyjątkiem.
automation/node_modules/
automation/.state/
automation/wypisani.txt
automation/outbox/*.json
!automation/outbox/przyklad.json
